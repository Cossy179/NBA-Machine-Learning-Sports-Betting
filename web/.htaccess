RewriteEngine On

# Fix Authorization header for Apache
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# API routes - redirect all API calls to api.php with route parameter
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api.php?route=api/$1 [QSA,L]

# Static files - serve directly if they exist
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.*)$ $1 [L]

# Fallback for other routes to api.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ api.php?route=$1 [QSA,L]

# Prevent directory browsing
Options -Indexes

# Block access to sensitive files
<Files "*.sql">
    Deny from all
</Files>

<Files "*.log">
    Deny from all
</Files>

<Files "web_database.db">
    Deny from all
</Files>

<Files "config.php">
    Deny from all
</Files>